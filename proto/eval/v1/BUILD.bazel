load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_python//python:proto.bzl", "py_proto_library")

package(default_visibility = ["//visibility:public"])

# Each proto file is exposed as its own proto_library so consumers depend
# only on what they need (avoids over-rebuilds when one file changes).

proto_library(
    name = "common_proto",
    srcs = ["common.proto"],
)

proto_library(
    name = "config_proto",
    srcs = ["config.proto"],
    deps = [
        ":common_proto",
        "@com_google_protobuf//:struct_proto",
    ],
)

proto_library(
    name = "manifest_proto",
    srcs = ["manifest.proto"],
    deps = [
        "@com_google_protobuf//:timestamp_proto",
    ],
)

proto_library(
    name = "metrics_proto",
    srcs = ["metrics.proto"],
    deps = [
        ":manifest_proto",
        "@com_google_protobuf//:struct_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

# Aggregate Python proto library so tools depend on a single target.
py_proto_library(
    name = "eval_py_proto",
    deps = [
        ":common_proto",
        ":config_proto",
        ":manifest_proto",
        ":metrics_proto",
    ],
)
