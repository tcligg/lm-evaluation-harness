load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "evalctl_lib",
    srcs = [
        "__init__.py",
        "cli.py",
        "config_loader.py",
        "manifest.py",
        "execution.py",
    ],
    deps = [
        "//proto/eval/v1:eval_py_proto",
        requirement("typer"),
        requirement("pyyaml"),
        requirement("protobuf"),
    ],
)

py_binary(
    name = "evalctl",
    srcs = ["__main__.py"],
    main = "__main__.py",
    deps = [":evalctl_lib"],
)

py_test(
    name = "config_loader_test",
    srcs = ["config_loader_test.py"],
    data = ["//examples/configs:gpqa_diamond_3shot_grok42.yaml"],
    deps = [":evalctl_lib"],
)

py_test(
    name = "manifest_test",
    srcs = ["manifest_test.py"],
    deps = [":evalctl_lib"],
)
