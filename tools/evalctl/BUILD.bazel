load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:private"])

# Proto-free helpers. Split out so they can be tested without depending on
# protoc/bazel codegen being available (see tools/evalctl/smoke_test.sh).
py_library(
    name = "pure_lib",
    srcs = [
        "__init__.py",
        "_pure.py",
    ],
    deps = [
        requirement("pyyaml"),
    ],
)

# Phase 1: programmatic dispatcher + repro/diff. Proto-free; depends on
# lm_eval at runtime via a lazy import (so unit tests can mock it).
py_library(
    name = "phase1_lib",
    srcs = [
        "programmatic.py",
        "repro.py",
    ],
    deps = [
        ":pure_lib",
    ],
)

py_library(
    name = "evalctl_lib",
    srcs = [
        "cli.py",
        "config_loader.py",
        "manifest.py",
        "execution.py",
    ],
    deps = [
        ":phase1_lib",
        ":pure_lib",
        "//proto/eval/v1:eval_py_proto",
        requirement("typer"),
        requirement("pyyaml"),
        requirement("protobuf"),
    ],
)

py_binary(
    name = "evalctl",
    srcs = ["__main__.py"],
    main = "__main__.py",
    deps = [":evalctl_lib"],
)

# Proto-free tests. Runnable on any host with PyYAML.
py_test(
    name = "pure_test",
    srcs = ["pure_test.py"],
    data = ["//examples/configs:gpqa_diamond_3shot_grok42.yaml"],
    deps = [":pure_lib"],
)

py_test(
    name = "repro_test",
    srcs = ["repro_test.py"],
    deps = [":phase1_lib"],
)

py_test(
    name = "programmatic_test",
    srcs = ["programmatic_test.py"],
    deps = [":phase1_lib"],
)

# Proto-coupled tests. Require py_proto_library to be built.
py_test(
    name = "config_loader_test",
    srcs = ["config_loader_test.py"],
    data = ["//examples/configs:gpqa_diamond_3shot_grok42.yaml"],
    deps = [":evalctl_lib"],
)

py_test(
    name = "manifest_test",
    srcs = ["manifest_test.py"],
    deps = [":evalctl_lib"],
)
