# Keep the build context lean. Anything not on this list still gets
# included; this file removes the obvious offenders.

# VCS
.git
.gitignore

# Bazel build outputs (we use pip in-image, not bazel)
bazel-*
.bazel-cache

# IDE / editor
.vscode
.idea
*.swp

# Local dev state
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.tox

# Result artifact directories from ad-hoc runs (large; never needed
# inside the image)
/grok-*
/groq-*
/results
/results-rerun
/samples
/n_shot_results

# Logs / one-off scratch
*.log
analysis_output.txt
invalid_responses.csv
invalid_flexible_responses.csv
invalid_patterns.txt
failure_examples.md
process_samples.py
analyze_results.py
create_invalid_csv.py
request*.json
refresh_token.sh

# Docs (not needed at runtime)
docs/img

# Tests live in the image but unit-test fixtures don't
tests/__pycache__
