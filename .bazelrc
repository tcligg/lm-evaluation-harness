# Use bzlmod (Bazel module system); legacy WORKSPACE disabled.
common --enable_bzlmod
common --noenable_workspace

# Quieter output by default; CI overrides as needed.
build --show_timestamps
build --verbose_failures

# Stamp built artifacts with VCS info (consumed by manifest builder).
build --stamp
build --workspace_status_command=tools/bazel/workspace_status.sh

# Python: hermetic toolchain via rules_python.
build --incompatible_default_to_explicit_init_py

# Test output.
test --test_output=errors
