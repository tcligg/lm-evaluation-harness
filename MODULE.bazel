"""Bazel module definition for the eval runner system.

Pinned dependency versions live here. Bumping any of these is a reviewable
change; CI re-runs `bazel test //...` against the new pins.
"""

module(
    name = "eval_runner",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "0.36.0")
bazel_dep(name = "rules_proto", version = "6.0.2")
bazel_dep(name = "protobuf", version = "27.3", repo_name = "com_google_protobuf")

# Python toolchain pinned to match the runtime image.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
    is_default = True,
)

# PyPI dependencies. Locked via tools/python/requirements.txt.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.11",
    requirements_lock = "//tools/python:requirements_lock.txt",
)
use_repo(pip, "pypi")
